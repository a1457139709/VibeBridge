{
  "name": "vibebridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "main": "dist/main.cjs",
  "scripts": {
    "prepare": "husky",
    "check:source-paths": "node scripts/check-source-paths.mjs",
    "check:staged-size": "node scripts/check-staged-file-size.mjs",
    "prepare:runtime": "node scripts/prepare.mjs",
    "check": "npm run check:source-paths && npm run typecheck && npm test && npm run test:components",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:components": "node scripts/test-components.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:desktop:all": "node scripts/test-desktop.mjs --all",
    "build": "npm run typecheck && node scripts/build.mjs && vite build",
    "start": "node scripts/start.mjs",
    "dev": "npm run build && npm start",
    "package": "npm run prepare:runtime && npm run build && node scripts/package.mjs",
    "rebuild:terminal": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/css.escape": "1.5.2",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "css.escape": "1.5.1",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
