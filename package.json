{
  "name": "vibebridge-ui-prototype",
  "private": true,
  "version": "0.0.0-prototype",
  "type": "module",
  "scripts": {
    "prototype:terminal": "node plans/terminal.prototype/launch.prototype.mjs",
    "check:terminal": "tsc --noEmit -p plans/terminal.prototype/tsconfig.json",
    "rebuild:terminal": "electron-rebuild -f -w node-pty",
    "prototype": "vite --config plans/ui.prototype/vite.config.ts",
    "check:prototype": "tsc --noEmit -p plans/ui.prototype/tsconfig.json",
    "build:prototype": "npm run check:prototype && vite build --config plans/ui.prototype/vite.config.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
