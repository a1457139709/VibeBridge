        "ynne/no-chain-state-updates": "warn",
        "ynne/no-event-handler": "warn",
        "ynne/no-adjust-state-on-prop-change": "warn",
        "ynne/no-reset-all-state-on-prop-change": "warn",
        "ynne/no-pass-live-state-to-parent": "warn",
        "ynne/no-pass-data-to-parent": "warn",
